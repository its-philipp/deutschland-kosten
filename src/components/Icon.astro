---
import type { IconName } from '../lib/icons';

/** Reference into the sprite that BaseLayout inlines. Decorative by default. */
interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'h-6 w-6' } = Astro.props;
---

<svg class={className} aria-hidden="true" focusable="false">
  <use href={`#i-${name}`}></use>
</svg>
